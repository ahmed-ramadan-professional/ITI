{
  "name": "logforge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:dashboard",
    "dev:api": "npm run dev -w @logforge/api",
    "dev:dashboard": "npm run dev -w @logforge/dashboard",
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md,css,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.0"
  }
}
